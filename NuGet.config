<?xml version="1.0" encoding="utf-8"?>
<!-- Central package management needs an explicit source mapping as soon as more than one source
     is configured on a machine; without this file the machine's own sources leak in and every
     restore reports NU1507, and the CodeCharter MSBuild workspace refuses to load the solution.
     Every package this repository restores comes from nuget.org; the Bsft packages themselves are
     project references here and only ever leave through release.yml, which names its feed
     explicitly. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
