{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "rules": {
    "InvalidCref": "info"
  },
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "**/*.csproj" ]
        }
      ],
      "dest": "api",
      "noRestore": true,
      "properties": { "TargetFramework": "net10.0" },
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "index.md", "toc.yml", "docs/toc.yml", "api/**.yml", "api/index.md" ]
      },
      {
        "src": "../docs",
        "dest": "docs",
        "files": [ "**/*.md" ]
      },
      {
        "src": "../src",
        "dest": "src",
        "files": [ "*/README.md" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "xref": [ "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json" ],
    "globalMetadata": {
      "_appName": "Bsft Foundation",
      "_appTitle": "Bsft Foundation",
      "_appFooter": "Bsft Foundation is free (MIT). Commercial extensions by <a href=\"https://www.bochmann-software.com/\">Bochmann Software GmbH</a>.",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    },
    "sitemap": {
      "baseUrl": "https://bochmann-software.github.io/bsft-foundation/",
      "changefreq": "weekly"
    }
  }
}
