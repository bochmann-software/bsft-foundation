<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework saga/flow engine on top of IEventAggregator</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.EventAggregator.Saga.EFCore" />
    <InternalsVisibleTo Include="Bsft.EventAggregator.Saga.Tests" />
    <InternalsVisibleTo Include="Bsft.EventAggregator.Saga.EFCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bsft.Calendar\Bsft.Calendar.csproj" />
    <ProjectReference Include="..\Bsft.Core\Bsft.Core.csproj" />

    <!-- The shared paging vocabulary, so the operator listing speaks the same PagedRequest /
         PagedResult every other admin list in the framework speaks. It carries no dependencies
         of its own. -->
    <ProjectReference Include="..\Bsft.Data.Contracts\Bsft.Data.Contracts.csproj" />
    <ProjectReference Include="..\Bsft.EventAggregator\Bsft.EventAggregator.csproj" />
    <ProjectReference Include="..\Bsft.Instrumentation\Bsft.Instrumentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
