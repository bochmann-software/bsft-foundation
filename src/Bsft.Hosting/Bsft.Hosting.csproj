<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework hosting defaults for ASP.NET Core: CORS, rate limiting, response compression, JSON, HTTPS redirection, health checks, the exception middleware, host logging and startup validation. No Swashbuckle or API-versioning dependency; OpenAPI, versioning and AddBsftDefaults are in Bsft.Hosting.OpenApi.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.Hosting.Tests" />
    <!-- AddBsftDefaults in Bsft.Hosting.OpenApi composes each component through its internal Add, the one
         place that binds the component's section and applies its delegate. -->
    <InternalsVisibleTo Include="Bsft.Hosting.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bsft.Core\Bsft.Core.csproj" />
    <!-- The background-work pieces (run-once services, bounded pipelines) moved into their own package so
         a console tool can take them without the web stack below. Referenced here, not re-exported by
         source, so a host that takes Bsft.Hosting still gets them. -->
    <ProjectReference Include="..\Bsft.Hosting.BackgroundWork\Bsft.Hosting.BackgroundWork.csproj" />
    <ProjectReference Include="..\Bsft.Correlation\Bsft.Correlation.csproj" />
    <!-- The dependency-free query contracts (the filter AST, the paged request). Deliberately the
         Contracts package and not Bsft.Data: the filter transport only parses the AST, it never
         compiles it, so Bsft.Hosting stays free of the EF Core dependency Bsft.Data would drag in. -->
    <ProjectReference Include="..\Bsft.Data.Contracts\Bsft.Data.Contracts.csproj" />
    <ProjectReference Include="..\Bsft.Instrumentation\Bsft.Instrumentation.csproj" />
    <ProjectReference Include="..\Bsft.Logging\Bsft.Logging.csproj" />
  </ItemGroup>

  <!-- No Swashbuckle and no Asp.Versioning: OpenAPI, API versioning and AddBsftDefaults, which composes them,
       live in Bsft.Hosting.OpenApi, so a host that pins its own Swashbuckle can still take this package.
       DependencyClosureTests pins it. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
