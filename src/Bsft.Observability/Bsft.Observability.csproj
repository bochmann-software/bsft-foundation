<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework OpenTelemetry integration: AddBsftObservability wires traces and metrics (OTLP + console), optional OTLP/console log export, and discovers Bsft instrumentation sources registered via Bsft.Instrumentation.</Description>
    <!--
      NU5104: OpenTelemetry.Instrumentation.EntityFrameworkCore ships pre-release only
      (no stable build has ever been published upstream). Packing this stable package with
      that dependency is intentional, so suppress the stable-depends-on-prerelease warning.
    -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.Observability.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bsft.Correlation.Abstractions\Bsft.Correlation.Abstractions.csproj" />
    <ProjectReference Include="..\Bsft.Instrumentation\Bsft.Instrumentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
  </ItemGroup>
</Project>
