<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework mediator pipeline behavior that retries requests marked with [Retryable] on transient failures, built on Polly.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.Resilience.Mediator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- No reference to Bsft.Resilience: the HTTP half and the mediator half share their name and
         nothing else, so a host retrying commands takes neither Polly's HTTP stack nor the
         correlation handler along. -->
    <ProjectReference Include="..\Bsft.Core\Bsft.Core.csproj" />
    <ProjectReference Include="..\Bsft.Mediator.Abstractions\Bsft.Mediator.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>
</Project>
