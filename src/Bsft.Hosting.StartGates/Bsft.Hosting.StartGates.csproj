<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework start gates for hosted background loops: register a precondition once and every loop registered through AddBsftGatedHostedService starts only after it has opened. The loops themselves know nothing about gates.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.Hosting.StartGates.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only Bsft reference: the gate contract lives in Bsft.Core, which has no package references
         of its own, so a loop package that takes this one pays for the wrapper and nothing else. -->
    <ProjectReference Include="..\Bsft.Core\Bsft.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
