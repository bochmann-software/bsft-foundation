<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework bridge that folds the current tenant into every Bsft.Caching key, so a cacheable query answered for one tenant is never served to another.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.Caching.Data.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bsft.Caching\Bsft.Caching.csproj" />
    <ProjectReference Include="..\Bsft.Data\Bsft.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
