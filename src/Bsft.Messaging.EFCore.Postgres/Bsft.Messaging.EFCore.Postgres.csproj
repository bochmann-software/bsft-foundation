<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework PostgreSQL LISTEN/NOTIFY wake-up for the Bsft.Messaging EF Core outbox: the dispatcher drains on commit instead of waiting for its next poll.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.Messaging.EFCore.Postgres.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bsft.Core\Bsft.Core.csproj" />
    <ProjectReference Include="..\Bsft.Messaging.EFCore\Bsft.Messaging.EFCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
</Project>
