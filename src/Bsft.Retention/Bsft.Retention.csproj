<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework retention: a hosted sweeper that drives one bounded purge pass per set of records a package owns</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.Retention.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only Bsft reference, and the reason this package exists: PollLoop is the loop every
         purging package was copying, and Bsft.Core has no package references of its own, so a
         package that purges pays for the sweeper and for nothing else. -->
    <ProjectReference Include="..\Bsft.Core\Bsft.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
