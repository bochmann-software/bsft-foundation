<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(BsftFoundationVersion)</Version>
    <Description>BSFT Framework bounded JSON Schema subset: reads a schema submitted by an untrusted party, refuses everything outside the subset, and validates a document against it with refusals a person can read</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bsft.Schema.Tests" />
    <!-- Most of the composition here is internal, so a test that substitutes one collaborator needs
         the proxy generator to see those interfaces. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
